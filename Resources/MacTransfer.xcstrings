    "mt_055": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log collection works only while unlocked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログ収集は端末のロック解除中のみ可能"
          }
        },
        "de": {

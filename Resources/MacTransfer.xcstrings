    "mt_087": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View connection, transfer, and import events. Raw analytics logs and pairing keys are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続・受信・解析の状態を確認できます。解析ログ本文やペアリング鍵は含まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungs-, Übertragungs- und Importereignisse anzeigen. Rohe Analysedaten und Kopplungsschlüssel sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los eventos de conexión, transferencia e importación. No se incluyen registros de análisis sin procesar ni claves de emparejamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les événements de connexion, de transfert et d’importation. Les journaux d’analyse bruts et les clés de jumelage sont exclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결·전송·가져오기 이벤트를 확인합니다. 분석 로그 원문과 페어링 키는 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看连接、传输和导入事件。不包含原始分析日志或配对密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視連線、傳輸和匯入事件。不包含原始分析日誌或配對金鑰。"
          }
        }
      }
    },

    "mt_031": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is in beta. A fix may take time, and we may not be able to reply individually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はベータ版です。解決に時間がかかる場合があり、個別に返信できない場合もあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion befindet sich in der Beta-Phase. Eine Reparatur kann einige Zeit in Anspruch nehmen und wir können möglicherweise nicht einzeln antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función está en fase beta. Una solución puede llevar tiempo y es posible que no podamos responder individualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonctionnalité est en version bêta. Un correctif peut prendre du temps et nous pourrions ne pas être en mesure de répondre individuellement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능은 베타 버전입니다. 보완하는 데 시간이 걸릴 수 있으며 개별적으로 회신하지 못할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能处于测试阶段。改进可能需要一段时间，我们可能无法单独回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能處於測試階段。修繕工作可能需要一段時間，我們可能無法個別回覆。"
          }
        }
      }
    },

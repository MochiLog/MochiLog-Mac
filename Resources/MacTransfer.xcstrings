    "mt_023": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can report connection failures with saved diagnostics, even while offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できない場合も、保存済みの診断情報を添付して報告できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Verbindungsausfälle mit gespeicherten Diagnosen melden, auch wenn Sie offline sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede informar de fallos de conexión con los diagnósticos guardados, incluso sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez signaler les échecs de connexion avec les diagnostics enregistrés, même hors ligne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태에서도 저장된 진단 프로그램으로 연결 실패를 보고할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使在离线时，您也可以使用保存的诊断程序报告连接故障。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使離線，您也可以使用儲存的診斷程式回報連線失敗。"
          }
        }
      }
    },

    "mt_084": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To refresh the Mac report, open the Mac app on the same Wi-Fi, then reopen this screen. Raw analytics logs and pairing secrets are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの情報を更新するには同じWi-FiでMacアプリを開き、この画面を開き直してください。解析ログ本文やペアリングの秘密鍵は含めません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Mac-App im selben WLAN und öffnen Sie dann diese Seite erneut, um den Mac-Bericht zu aktualisieren. Rohdaten der Analyse und Kopplungsgeheimnisse sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para actualizar el informe del Mac, abre la app de Mac en la misma red Wi‑Fi y vuelve a abrir esta pantalla. No se incluyen registros de análisis sin procesar ni claves de emparejamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour actualiser le rapport du Mac, ouvrez l’app Mac sur le même réseau Wi‑Fi, puis rouvrez cet écran. Les journaux d’analyse bruts et les clés de jumelage sont exclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 보고서를 갱신하려면 동일한 Wi‑Fi에서 Mac 앱을 연 다음 이 화면을 다시 여세요. 분석 로그 원문과 페어링 비밀키는 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更新 Mac 报告，请在同一 Wi‑Fi 下打开 Mac 应用，然后重新打开此页面。不包含原始分析日志或配对密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要更新 Mac 報告，請在同一 Wi‑Fi 下開啟 Mac App，然後重新開啟此頁面。不包含原始分析日誌或配對金鑰。"
          }
        }
      }
    },

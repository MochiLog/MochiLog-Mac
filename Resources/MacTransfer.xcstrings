    "mt_070": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach Mac and iPhone diagnostics. A fix may take time, and we may not be able to reply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacとiPhoneの診断情報を添付できます。解決に時間がかかる場合があり、返信できない場合もあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosedaten von Mac und iPhone anhängen. Eine Lösung kann Zeit brauchen; möglicherweise können wir nicht antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta los diagnósticos del Mac y el iPhone. La solución puede tardar y quizá no podamos responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez les diagnostics du Mac et de l’iPhone. La résolution peut prendre du temps et nous pourrions ne pas répondre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 iPhone 진단 정보를 첨부할 수 있습니다. 해결에 시간이 걸리거나 답변을 드리지 못할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可附加 Mac 和 iPhone 诊断信息。解决问题可能需要时间，也可能无法回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可附加 Mac 和 iPhone 診斷資訊。解決問題可能需要時間，也可能無法回覆。"
          }
        }
      }
    },
